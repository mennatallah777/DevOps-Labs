@Library('ivolve-lib') _

pipeline {
    agent { label 'vm-agent' }

    environment {
        IMAGE = "mennayasser777/demoapp"
        TAG   = "gitops-${BUILD_NUMBER}"
    }

    stages {
        stage('Clone') {
            steps {
                dir('app') {
                    git url: 'https://github.com/Ibrahim-Adel15/DemoApp.git', branch: 'main'
                }
            }
        }

        stage('Build App') {
            steps {
                BuildApp('app')
            }
        }

        stage('Build Image') {
            steps {
                BuildImage(image: env.IMAGE, tag: env.TAG, credentialsId: 'dockerhub', appDir: 'app')
            }
        }

        stage('Push to GitOps Repo') {
            steps {
                DeployOnK8s(image: env.IMAGE, tag: env.TAG, file: 'Jenkins/Lab23/k8s/deployment.yaml',
                            gitPush: true, credentialsId: 'github', repo: 'github.com/mennatallah777/DevOps-Labs.git')
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            echo "Pipeline finished: build #${BUILD_NUMBER}"
            deleteDir()
        }
        success {
            echo "Success: ${IMAGE}:${TAG} pushed to Git, Argo CD will sync it"
        }
        failure {
            echo "Failed: check the stage logs above"
        }
    }
}
