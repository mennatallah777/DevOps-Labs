pipeline {
    agent { label 'vm-agent' }

    environment {
        IMAGE = "mennayasser777/demoapp"
        TAG   = "${BUILD_NUMBER}"
    }

    stages {
        stage('Clone') {
            steps {
                dir('app') {
                    git url: 'https://github.com/Ibrahim-Adel15/DemoApp.git', branch: 'main'
                }
            }
        }

        stage('Build App') {
            steps {
                dir('app') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    sh 'docker build -t $IMAGE:$TAG .'
                }
            }
        }

        stage('Scan Docker Image') {
            steps {
                sh 'trivy image --severity HIGH,CRITICAL --exit-code 0 --no-progress $IMAGE:$TAG'
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                    sh 'docker push $IMAGE:$TAG'
                }
            }
        }

        stage('Delete Image Locally') {
            steps {
                sh 'docker rmi $IMAGE:$TAG'
            }
        }

        stage('Update Deployment File') {
            steps {
                sh 'sed -i "s|image: .*|image: $IMAGE:$TAG|" Jenkins/Lab21/deployment.yaml'
                sh 'grep image: Jenkins/Lab21/deployment.yaml'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl apply -f Jenkins/Lab21/deployment.yaml'
                sh 'kubectl rollout status deployment/demoapp --timeout=180s'
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            echo "Pipeline finished: build #${BUILD_NUMBER}"
            deleteDir()
        }
        success {
            echo "Success: ${IMAGE}:${TAG} deployed to Kubernetes"
        }
        failure {
            echo "Failed: check the stage logs above"
        }
    }
}
